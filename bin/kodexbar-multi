#!/usr/bin/env bash
# KODEXBAR_MULTI_BUNDLED_WRAPPER v1
set -u

self_path=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")

resolve_command() {
    local configured candidate resolved
    configured=${KODEXBAR_CODEXBAR_COMMAND-}
    if [[ -n $configured ]]; then
        if [[ $configured == */* ]]; then
            candidate=$configured
        else
            candidate=$(command -v -- "$configured" 2>/dev/null || true)
        fi
    else
        candidate=$(command -v codexbar 2>/dev/null || true)
        [[ -n $candidate ]] || candidate=${XDG_BIN_HOME:-$HOME/.local/bin}/codexbar
    fi

    if [[ -z ${candidate:-} || ! -x $candidate ]]; then
        printf 'kodexbar-multi: upstream codexbar CLI not found; install codexbar or set KODEXBAR_CODEXBAR_COMMAND to its executable path\n' >&2
        return 1
    fi
    resolved=$(readlink -f "$candidate" 2>/dev/null || printf '%s' "$candidate")
    if [[ $resolved == "$self_path" || $candidate -ef "$0" ]]; then
        printf 'kodexbar-multi: KODEXBAR_CODEXBAR_COMMAND resolves to kodexbar-multi itself; set it to the upstream codexbar executable\n' >&2
        return 1
    fi
    printf '%s\n' "$candidate"
}

upstream=$(resolve_command) || exit 127

local_activity_epoch() {
    local home=$1 latest
    [[ -d $home/sessions ]] || return 0
    latest=$(find "$home/sessions" -type f -name '*.jsonl' -printf '%T@\n' 2>/dev/null | sort -nr | head -n 1)
    [[ -n $latest ]] || return 0
    awk -v value="$latest" 'BEGIN { printf "%.0f\n", value }'
}

local_activity_timestamp() {
    local timestamp
    timestamp=$(local_activity_epoch "$1")
    [[ -n $timestamp ]] || return 0
    local_activity_iso "$timestamp"
}

local_activity_iso() {
    local timestamp=$1
    [[ $timestamp =~ ^[0-9]+$ ]] || return 0
    date -u -d "@$timestamp" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true
}

codex_config_homes() {
    local config_file=${XDG_CONFIG_HOME:-$HOME/.config}/codexbar/config.json
    [[ -r $config_file ]] || return 0
    jq -r '
        .providers? | if type == "array" or type == "object" then .[] else empty end
        | if type == "object" then .codexProfileHomePaths? else empty end
        | if type == "array" then .[] else . end
        | select(type == "string" and length > 0)' "$config_file" 2>/dev/null || true
}

codex_candidate_homes() {
    {
        codex_config_homes
        printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
    } | awk 'NF && !seen[$0]++'
}

codex_identity_for_home() {
    local home=$1 payload identities identity_count
    payload=$(CODEX_HOME="$home" "$upstream" usage --provider codex --all-accounts --format json --json-only 2>/dev/null) || return 1
    identities=$(jq -r '
        [if type == "array" then .[] else . end
         | (.account // .usage.accountEmail // .usage.identity.accountEmail // empty)
         | select(type == "string" and length > 0)]
        | unique | .[]' <<<"$payload" 2>/dev/null) || return 1
    identity_count=$(grep -c . <<<"$identities" || true)
    [[ $identity_count == 1 ]] || return 1
    printf '%s\n' "$identities"
}

codex_activity_map() {
    local spec account home timestamp iso newest_epoch=-1 newest_home="" tied=0 identity
    # Explicit account=home mappings remain authoritative and avoid another CLI query.
    if [[ -n ${KODEXBAR_CODEX_ACCOUNT_HOMES-} ]]; then
        while IFS= read -r spec; do
            [[ $spec == *=* ]] || continue
            account=${spec%%=*}
            home=${spec#*=}
            iso=$(local_activity_timestamp "$home")
            [[ -n $iso ]] && jq -cn --arg key "$account" --arg value "$iso" '[{key: $key, value: $value}] | from_entries'
        done < <(printf '%s' "$KODEXBAR_CODEX_ACCOUNT_HOMES" | tr ';' '\n') | jq -s 'add // {}'
        return 0
    fi
    if [[ -n ${KODEXBAR_CODEX_HOME-} ]]; then
        home=$KODEXBAR_CODEX_HOME
        iso=$(local_activity_timestamp "$home")
        [[ -n $iso ]] && jq -cn --arg value "$iso" '{"*": $value}'
        return 0
    fi
    while IFS= read -r home; do
        timestamp=$(local_activity_epoch "$home")
        [[ $timestamp =~ ^[0-9]+$ ]] || continue
        if (( timestamp > newest_epoch )); then
            newest_epoch=$timestamp
            newest_home=$home
            tied=0
        elif (( timestamp == newest_epoch )); then
            tied=1
        fi
    done < <(codex_candidate_homes)
    (( newest_epoch >= 0 && tied == 0 )) || { printf '{}\n'; return 0; }
    identity=$(codex_identity_for_home "$newest_home") || { printf '{}\n'; return 0; }
    iso=$(local_activity_iso "$newest_epoch")
    jq -cn --arg key "$identity" --arg value "$iso" '[{key: $key, value: $value}] | from_entries'
}

opencode_activity_iso() {
    local db=${KODEXBAR_OPENCODE_DB-${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db}
    local timestamp seconds
    [[ -r $db ]] || return 0
    timestamp=$(sqlite3 -readonly "$db" 'SELECT max(time_updated) FROM session WHERE time_updated IS NOT NULL;' 2>/dev/null || true)
    [[ $timestamp =~ ^[0-9]+$ ]] || return 0
    seconds=$timestamp
    (( timestamp > 10000000000 )) && seconds=$((timestamp / 1000))
    local_activity_iso "$seconds"
}

enrich_activity() {
    local name=$1 file=$2 activity
    if [[ $name == codex ]]; then
        activity=$(codex_activity_map)
        jq --argjson activity "$activity" '
            def account_key: (.account // .usage.accountEmail // .usage.identity.accountEmail // "");
            if type == "array" then
                map(if ($activity[account_key] // (if length == 1 then $activity["*"] else null end)) then .activity = {lastActivityAt: ($activity[account_key] // $activity["*"]), source: "local"} else . end)
            elif ($activity[account_key] // $activity["*"]) then .activity = {lastActivityAt: ($activity[account_key] // $activity["*"]), source: "local"}
            else . end' "$file" >"$file.enriched" && mv "$file.enriched" "$file" || return 1
    elif [[ $name == opencode ]]; then
        activity=$(opencode_activity_iso)
        [[ -n $activity ]] || return 0
        jq --arg value "$activity" 'if type == "array" and length == 1 then map(.activity = {lastActivityAt: $value, source: "local"}) elif type == "object" then .activity = {lastActivityAt: $value, source: "local"} else . end' "$file" >"$file.enriched" && mv "$file.enriched" "$file" || return 1
    fi
}

nan_command() {
    local configured candidate
    configured=${KODEXBAR_NAN_COMMAND-}
    if [[ -n $configured ]]; then
        if [[ $configured == */* ]]; then
            candidate=$configured
        else
            candidate=$(command -v -- "$configured" 2>/dev/null || true)
        fi
    else
        candidate=$(command -v nan 2>/dev/null || true)
        [[ -n $candidate ]] || candidate=${XDG_BIN_HOME:-$HOME/.local/bin}/nan
    fi

    if [[ -z ${candidate:-} || ! -x $candidate ]]; then
        return 1
    fi
    printf '%s\n' "$candidate"
}

# nan_account prints the NaN account email when the optional CLI reports one. It
# never fails: a missing CLI or malformed identity simply yields no account, so
# the cloud quota path stays independent of the `nan` CLI.
nan_account() {
    local command identity
    command=$(nan_command) || return 0
    identity=$("$command" me 2>/dev/null || true)
    if [[ -n $identity ]] && jq -e . >/dev/null 2>&1 <<<"$identity"; then
        jq -r '.email // empty' <<<"$identity" 2>/dev/null || true
    fi
}

# nan_quota_command resolves the bundled local quota helper. The override selects
# an executable, never a network target; any executable named here runs with
# access to the Chrome session, so override it only with a trusted helper. The
# bundled helper's own HTTPS target is fixed, so the override cannot change that
# endpoint -- it only substitutes a different (trusted) program.
nan_quota_command() {
    local configured candidate
    configured=${KODEXBAR_NAN_QUOTA_COMMAND-}
    if [[ -n $configured ]]; then
        if [[ $configured == */* ]]; then
            candidate=$configured
        else
            candidate=$(command -v -- "$configured" 2>/dev/null || true)
        fi
    else
        # Prefer the copy installed next to this wrapper, then PATH, then the
        # default install directory. A missing or non-executable candidate is a
        # silent skip, not an error.
        candidate=$(dirname "$self_path")/nan-cloud-quota
        if [[ ! -x $candidate ]]; then
            candidate=$(command -v nan-cloud-quota 2>/dev/null || true)
        fi
        [[ -n $candidate ]] || candidate=${XDG_BIN_HOME:-$HOME/.local/bin}/nan-cloud-quota
    fi

    if [[ -z ${candidate:-} || ! -x $candidate ]]; then
        return 1
    fi
    printf '%s\n' "$candidate"
}

# nan_quota_entry prefers the local cloud quota helper, which reads the existing
# Chrome session, over the `nan` CLI metrics. The helper's stderr is discarded so
# a failed helper can never leak wallet or cookie diagnostics into the aggregate
# or the wrapper's own stderr. Any missing helper, non-zero exit, malformed, or
# off-shape payload returns non-zero so the caller can fall back to CLI metrics.
nan_quota_entry() {
    local output=$1 helper quota account updated_at
    helper=$(nan_quota_command) || return 1
    quota=$("$helper" 2>/dev/null) || return 1
    [[ -n $quota ]] || return 1
    # Validate every required field, not just the top level: a helper that emits a
    # structurally valid envelope with a malformed model must not win the cloud
    # branch and leave blank popup rows, so it falls back to the CLI instead. An
    # empty models list is rejected for the same reason.
    jq -e '
        def uint: type == "number" and . >= 0 and (. == floor);
        def nan_model:
            type == "object"
            and (.model | type == "string" and length > 0)
            and (.periodEnd | type == "string")
            and (.tokensUsed | uint)
            and (.cap | uint)
            and (.remaining | uint)
            and (if has("updatedAt") then (.updatedAt | type == "string") else true end)
            and (if has("fullWindowTokens") then (.fullWindowTokens | uint) else true end)
            and (if has("windowHours") then (.windowHours | uint) else true end);
        type == "object"
        and (.periodStart | type == "string")
        and (.models | type == "array" and length > 0)
        and ([.models[] | nan_model] | all)
    ' >/dev/null 2>&1 <<<"$quota" || return 1

    account=$(nan_account)
    # Surface a per-model timestamp only when the helper actually reported one;
    # never invent a time for quota that carries no timestamp.
    updated_at=$(jq -r '[.models[]? | .updatedAt? // empty] | max // empty' <<<"$quota" 2>/dev/null || true)

    jq -n --argjson quota "$quota" --arg account "$account" --arg updatedAt "$updated_at" '
        {provider: "nan", source: "cloud"}
        + (if $account != "" then {account: $account} else {} end)
        + {usage: ({nanQuota: $quota} + (if $updatedAt != "" then {updatedAt: $updatedAt} else {} end))}
    ' >"$output"
}

# nan_usage_entry transforms `nan metrics usage` into a CodexBar-shaped entry so the
# popup can render it. It is the fallback when the cloud quota helper is missing
# or fails. NaN is optional: any failure keeps the aggregate intact.
nan_usage_entry() {
    local output=$1 command metrics account updated_at attempt
    command=$(nan_command) || return 1
    # `nan metrics usage` fails transiently in streaks; one retry with a short backoff
    # recovers the common case. Invalid JSON is not retried and is handled below.
    metrics=""
    for attempt in 1 2; do
        metrics=$("$command" metrics usage 2>/dev/null) && [[ -n $metrics ]] && break
        metrics=""
        (( attempt < 2 )) && sleep 2
    done
    [[ -n $metrics ]] || return 1
    jq -e . >/dev/null 2>&1 <<<"$metrics" || return 1

    account=$(nan_account)
    updated_at=$(jq -r '.monthToDate.cachedAt // .allTime.cachedAt // empty' <<<"$metrics" 2>/dev/null || true)

    jq -n --argjson metrics "$metrics" --arg account "$account" --arg updatedAt "$updated_at" '
        {provider: "nan", source: "cli"}
        + (if $account != "" then {account: $account} else {} end)
        + {usage: ({nan: $metrics} + (if $updatedAt != "" then {updatedAt: $updatedAt} else {} end))}
    ' >"$output"
}

if [[ ${1-} != usage ]]; then
    exec "$upstream" "$@"
fi

has_provider=0
provider_codex=0
account_selector=0
previous_provider_flag=0
for arg in "$@"; do
    if (( previous_provider_flag )); then
        [[ $arg == codex ]] && provider_codex=1
        previous_provider_flag=0
        continue
    fi
    case $arg in
        --provider)
            has_provider=1
            previous_provider_flag=1
            ;;
        --provider=*)
            has_provider=1
            [[ ${arg#--provider=} == codex ]] && provider_codex=1
            ;;
        --account|--account=*|--account-id|--account-id=*|--email|--email=*|--profile|--profile=*|--all-accounts)
            account_selector=1
            ;;
    esac
done

if (( has_provider == 0 && account_selector == 1 )); then
    printf 'kodexbar-multi: account selection requires --provider codex; refusing to apply it to unrelated providers\n' >&2
    exit 2
fi

if (( has_provider == 0 )); then
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/kodexbar-multi.XXXXXX") || {
        printf 'kodexbar-multi: unable to create temporary directory\n' >&2
        exit 1
    }
    trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM
    successes=0
    outputs=()
    original_args=("$@")

    run_provider() {
        local name=$1 output=$tmpdir/$1.json
        shift
        if [[ $name == nan ]]; then
            # NaN is not a codexbar provider: prefer the local cloud quota helper
            # (Chrome session) and fall back to its own CLI metrics only when the
            # helper is missing or fails.
            if nan_quota_entry "$output" || nan_usage_entry "$output"; then
                outputs+=("$output")
                successes=$((successes + 1))
            fi
            return 0
        fi
        if "$upstream" "${original_args[@]}" --format json --json-only "$@" >"$output" 2>"$tmpdir/$name.stderr" \
            && jq -e . "$output" >/dev/null 2>&1; then
            if [[ $name == deepseek ]]; then
                jq 'def money: gsub("[, $]"; "") | tonumber;
                    def normalized:
                      try (.usage.primary.resetDescription
                        | capture("\\$(?<remaining>[0-9]+(?:\\.[0-9]+)?) \\((?:Paid): \\$(?<paid>[0-9]+(?:\\.[0-9]+)?) \\/ (?:Granted): \\$(?<granted>[0-9]+(?:\\.[0-9]+)?)\\)")
                        | {remaining: (.remaining|money), paidBalance: (.paid|money), grantedBalance: (.granted|money), currencyCode: "USD"})
                      catch null;
                    def normalize_entry:
                      if ((.provider // "" | ascii_downcase) == "deepseek" and normalized != null) then .credits = normalized else . end;
                    if (type == "array") then map(normalize_entry)
                    elif (type == "object") then normalize_entry
                    else . end' "$output" >"$tmpdir/$name.normalized" \
                    && mv "$tmpdir/$name.normalized" "$output" || return 1
            fi
            enrich_activity "$name" "$output" || true
            outputs+=("$output")
            successes=$((successes + 1))
        fi
    }

    run_provider codex --provider codex --all-accounts
    run_provider nan
    run_provider opencode --provider opencodego --source auto
    run_provider deepseek --provider deepseek --source api

    if (( successes == 0 )); then
        printf 'kodexbar-multi: all provider usage queries failed; check codexbar credentials and KODEXBAR_CODEXBAR_COMMAND\n' >&2
        exit 1
    fi
    jq -s '[.[] | if type == "array" then .[] else . end]' "${outputs[@]}" || {
        printf 'kodexbar-multi: provider output could not be aggregated as valid JSON\n' >&2
        exit 1
    }
    exit 0
fi

if (( provider_codex == 1 && account_selector == 0 )); then
    exec "$upstream" "$@" --all-accounts
fi
exec "$upstream" "$@"
